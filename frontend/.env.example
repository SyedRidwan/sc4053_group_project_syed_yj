# Copy to frontend/.env (git-ignored) and fill in as needed. Both are optional.

# WalletConnect / Reown project ID (free at https://cloud.reown.com).
# Without it, only browser-extension wallets such as MetaMask are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# Sepolia RPC endpoint; defaults to https://ethereum-sepolia-rpc.publicnode.com
VITE_SEPOLIA_RPC_URL=
